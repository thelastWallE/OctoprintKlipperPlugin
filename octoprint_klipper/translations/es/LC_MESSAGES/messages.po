#: octoprint_klipper/__init__.py:247
msgid "Allows to config klipper"
msgstr "Permite configurar Klipper"

#: octoprint_klipper/__init__.py:255
msgid "Allows to list klipper files"
msgstr "Permite listar archivos de Klipper"

#: octoprint_klipper/__init__.py:263
msgid "Allows to use klipper macros"
msgstr "Permite usar macros de Klipper"

#: octoprint_klipper/__init__.py:710
msgid "Help for configuring OctoPrint to use Klipper"
msgstr "Ayuda para configurar OctoPrint para usar Klipper"

#: octoprint_klipper/__init__.py:902
msgid "The configured serial port is not an absolute path."
msgstr "El puerto serie configurado no es una ruta absoluta."

#: octoprint_klipper/__init__.py:917
msgid "Invalid error handling value."
msgstr "Valor de gestión de errores no válido."

#: octoprint_klipper/__init__.py:927
msgid "The serial port must be an absolute path."
msgstr "El puerto serie debe ser una ruta absoluta."

#: octoprint_klipper/__init__.py:934
msgid "Unknown setup wizard action."
msgstr "Acción desconocida del asistente de configuración."

#: octoprint_klipper/__init__.py:1049
msgid "Invalid variable name"
msgstr "Nombre de variable no válido"

#: octoprint_klipper/__init__.py:1054
msgid "Value must be a valid Python literal"
msgstr "El valor debe ser un literal de Python válido"

#: octoprint_klipper/__init__.py:1063
#: octoprint_klipper/static/js/klipper.js:486
msgid "Printer not connected"
msgstr "Impresora no conectada"

#: octoprint_klipper/__init__.py:2278
msgid "Restart Klipper"
msgstr "Reiniciar Klipper"

#: octoprint_klipper/__init__.py:2285
msgid "You are about to restart Klipper!"
msgstr "Está a punto de reiniciar Klipper."

#: octoprint_klipper/__init__.py:2287
msgid "This will stop ongoing prints!"
msgstr "Esto detendrá las impresiones en curso."

#: octoprint_klipper/config_tools/CfgUtils.py:98
msgid "Error: Klipper config file not found at:"
msgstr "Error: no se encontró el archivo de configuración de Klipper en:"

#: octoprint_klipper/config_tools/CfgUtils.py:101
msgid "IOError:"
msgstr "Error de E/S:"

#: octoprint_klipper/config_tools/CfgUtils.py:108
msgid "Decode Error:"
msgstr "Error de decodificación:"

#: octoprint_klipper/config_tools/CfgUtils.py:112
msgid "Please convert your config files to utf-8!"
msgstr "¡Convierta sus archivos de configuración a utf-8!"

#: octoprint_klipper/config_tools/CfgUtils.py:115
msgid ""
"Or you can also paste your config \n"
"into the Editor and save it."
msgstr ""
"O también puede pegar su configuración\n"
"en el Editor y guardarla."

#: octoprint_klipper/config_tools/CfgUtils.py:122
msgid "File not found: "
msgstr "Archivo no encontrado: "

#: octoprint_klipper/config_tools/CfgUtils.py:216
msgid "Klipper config file saved!"
msgstr "¡Archivo de configuración de Klipper guardado!"

#: octoprint_klipper/config_tools/CfgUtils.py:341
msgid "Included file not found: "
msgstr "Archivo incluido no encontrado: "

#: octoprint_klipper/config_tools/CfgUtils.py:343
msgid "via"
msgstr "vía"

#: octoprint_klipper/config_tools/CfgUtils.py:515
#, python-brace-format
msgid "Klipper config file copied to {}"
msgstr "Archivo de configuración de Klipper copiado a {}"

#: octoprint_klipper/modules/SetupWizard.py:46
msgid "The micro-controller link. Without it Klipper cannot talk to the printer."
msgstr ""
"El enlace con el microcontrolador. Sin él Klipper no puede comunicarse "
"con la impresora."

#: octoprint_klipper/modules/SetupWizard.py:54
msgid ""
"High level printer settings (kinematics, max_velocity, max_accel). All "
"three are mandatory."
msgstr ""
"Ajustes generales de la impresora (kinematics, max_velocity, max_accel). "
"Los tres son obligatorios."

#: octoprint_klipper/modules/SetupWizard.py:63
msgid ""
"Lets Klipper read g-code from a host directory. Klipper's docs recommend "
"pointing path at OctoPrint's upload directory (~/.octoprint/uploads/)."
msgstr ""
"Permite a Klipper leer g-code desde un directorio del host. La "
"documentación de Klipper recomienda apuntar path al directorio de subidas"
" de OctoPrint (~/.octoprint/uploads/)."

#: octoprint_klipper/modules/SetupWizard.py:72
msgid ""
"Pause/Resume with position capture and restore. Without it OctoPrint's "
"pause is degraded."
msgstr ""
"Pausa/Reanudación con captura y restauración de posición. Sin esta "
"sección la pausa de OctoPrint se degrada."

#: octoprint_klipper/modules/SetupWizard.py:80
msgid "Enables cancelling individual objects during a print."
msgstr "Permite cancelar objetos individuales durante una impresión."

#: octoprint_klipper/modules/SetupWizard.py:87
msgid ""
"Needed by OctoKlipper's Save Variables dialog (requires a filename "
"option)."
msgstr ""
"Lo necesita el diálogo Guardar variables de OctoKlipper (requiere la "
"opción filename)."

#: octoprint_klipper/modules/SetupWizard.py:94
msgid "Controls what Klipper does when the printer sits idle."
msgstr "Controla lo que hace Klipper cuando la impresora está inactiva."

#: octoprint_klipper/modules/SetupWizard.py:101
msgid "Lets macros send messages to the OctoPrint console (M118 / RESPOND)."
msgstr ""
"Permite a las macros enviar mensajes a la consola de OctoPrint (M118 / "
"RESPOND)."

#: octoprint_klipper/modules/SetupWizard.py:128
msgid ""
"The Moonraker Connector is experimental and unfinished. It is version "
"0.1.0 with no published release, requires OctoPrint 2.0, and is still "
"under development. OctoKlipper's macros, config editor, Save Variables "
"and log analysis are built around the serial connection and are "
"unverified against it."
msgstr ""
"El Moonraker Connector es experimental e inacabado. Es la versión 0.1.0 "
"sin publicación alguna, requiere OctoPrint 2.0 y sigue en desarrollo. Las"
" macros, el editor de configuración, Guardar variables y el análisis de "
"registros de OctoKlipper se basan en la conexión serie y no están "
"verificados con él."

#: octoprint_klipper/modules/SetupWizard.py:476
#, python-format
msgid ""
"Klipper's host software only runs on Linux, so it cannot run on this "
"%(platform)s host. The Klipper path below may exist as a source checkout,"
" but OctoPrint cannot connect to a Klipper instance running here."
msgstr ""
"El software de host de Klipper solo se ejecuta en Linux, por lo que no "
"puede ejecutarse en este host %(platform)s. La ruta de Klipper de abajo "
"puede existir como copia del código fuente, pero OctoPrint no puede "
"conectarse a una instancia de Klipper que se ejecute aquí."

#: octoprint_klipper/modules/SetupWizard.py:480
msgid "non-Linux"
msgstr "no Linux"

#: octoprint_klipper/modules/SetupWizard.py:483
#, python-format
msgid "No Klipper installation found at %(path)s."
msgstr "No se encontró ninguna instalación de Klipper en %(path)s."

#: octoprint_klipper/modules/SetupWizard.py:486
msgid "The Klipper service is running."
msgstr "El servicio de Klipper está en ejecución."

#: octoprint_klipper/modules/SetupWizard.py:490
msgid ""
"Klipper is installed but its service is not running. Start it before "
"connecting."
msgstr ""
"Klipper está instalado, pero su servicio no está en ejecución. Inícielo "
"antes de conectarse."

#: octoprint_klipper/modules/SetupWizard.py:496
msgid ""
"The Klipper service is in a failed state. Check the Klipper log for the "
"reason it could not start."
msgstr ""
"El servicio de Klipper está en estado de error. Consulte el registro de "
"Klipper para averiguar por qué no pudo iniciarse."

#: octoprint_klipper/modules/SetupWizard.py:502
msgid ""
"Klipper is installed, but the state of its service could not be "
"determined."
msgstr ""
"Klipper está instalado, pero no se pudo determinar el estado de su "
"servicio."

#: octoprint_klipper/static/js/klipper.js:279
#: octoprint_klipper/templates/klipper_tab_main.jinja2:126
msgid ""
"This will cause the host software to reload its config and perform an "
"internal reset"
msgstr ""
"Esto hará que el software del host recargue su configuración y realice un"
" reinicio interno"

#: octoprint_klipper/static/js/klipper.js:281
#: octoprint_klipper/static/js/klipper.js:291
#: octoprint_klipper/static/js/klipper.js:301
#: octoprint_klipper/templates/klipper_tab_main.jinja2:138
msgid "You can set this command in the settings."
msgstr "Puede configurar este comando en los ajustes."

#: octoprint_klipper/static/js/klipper.js:283
#: octoprint_klipper/static/js/klipper.js:293
#: octoprint_klipper/static/js/klipper.js:303
msgid "Actual command: "
msgstr "Comando real: "

#: octoprint_klipper/static/js/klipper.js:289
#: octoprint_klipper/templates/klipper_tab_main.jinja2:131
msgid ""
"Similar to a host restart, but also clears any error state from the "
"micro-controller"
msgstr ""
"Similar a un reinicio del host, pero además borra cualquier estado de "
"error del microcontrolador"

#: octoprint_klipper/static/js/klipper.js:299
#: octoprint_klipper/templates/klipper_tab_main.jinja2:138
msgid "This will cause the host klipper service to immediately stop and restart!"
msgstr ""
"¡Esto hará que el servicio de Klipper del host se detenga y se reinicie "
"inmediatamente!"


<div id="klipper_offset_dialog" class="modal hide fade small" tabindex="-1" role="dialog"
  aria-labelledby="klipper_offset_dialog_label" aria-hidden="true">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h3>{{ _('Coordinate Offset') }}</h3>
  </div>
  <div class="modal-body">
    <div class="klipper-mb-3">
      <div class="control-label">{{ _('Set an offset for all future GCODE move commands in mm.') }}</div>
    </div>
    <div class="klipper-flex klipper-gap-2 klipper-mb-3">
      <div class="input-append klipper-flex-grow">
        <input type="text" class="input-block-level" data-bind="value: offsetX">
        <span class="add-on">X</span>
      </div>
      <div class="input-append klipper-flex-grow">
        <input type="text" class="input-block-level" data-bind="value: offsetY">
        <span class="add-on">Y</span>
      </div>
      <div class="input-append klipper-flex-grow">
        <input type="text" class="input-block-level" data-bind="value: offsetZ">
        <span class="add-on">Z</span>
      </div>
    </div>
    <div class="klipper-mb-3">
      <label class="checkbox">
        <input type="checkbox" data-bind="checked: adjust"
          id="settings-serialAutoconnect">{{ _('Add to existing offset') }}
      </label>
    </div>
    <div class="control-group">
      <div class="controls">
        <button class="btn btn-block" data-bind="click: setOffset" data-dismiss="modal"><i class="icon-cross"></i>
          {{ _('Set Offset') }}</button>
      </div>
    </div>
  </div>
</div>
